# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# docker compose의 db 서비스에 맞춘 로컬 개발용 주소
DATABASE_URL="postgresql://burden:burden@localhost:5432/burden?schema=public"

# 아래 두 키는 직접 만들어 넣는다(32바이트 base64). 만드는 명령:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 서버 JWT 서명 키
JWT_SECRET=
# refresh token 암호화 키. 바꾸면 저장된 refresh token을 풀 수 없어 모두 다시 로그인해야 한다.
TOKEN_ENC_KEY=

# 구글 OAuth 웹 클라이언트. 비워 두면 구글 로그인만 꺼지고 데모 로그인은 된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 모바일 앱의 serverAuthCode는 비워 둔다. 웹에서 시험할 때만 postmessage
GOOGLE_REDIRECT_URI=

# 자연어 입력의 LLM(Gemini). https://aistudio.google.com 에서 만든 키. 비워 두면 규칙만으로 해석한다.
# 무료 등급은 입력이 구글 제품 개선에 쓰일 수 있다.
GEMINI_API_KEY=
# 비워 두면 gemini-3.8-flash
GEMINI_MODEL=
